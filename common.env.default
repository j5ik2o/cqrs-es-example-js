# Copy to common.env and adjust. common.env is gitignored.
# Host-side AWS CLI uses this URL (Compose maps LocalStack to host port 34566).
LOCALSTACK_ENDPOINT_URL=http://localhost:34566

AWS_REGION=ap-northeast-1
AWS_DEFAULT_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=x
AWS_SECRET_ACCESS_KEY=x

# The RMU subscribes to the aggregate head Streams. The journal table is read
# with strong consistency only to fill a sequence gap; its Streams stay disabled.
STREAM_HEAD_TABLE_NAME=head
STREAM_JOURNAL_TABLE_NAME=journal
STREAM_MAX_ITEM_COUNT=32

# Recovery: event-level retry ceiling before a dead letter is persisted.
# Stream-level backoff is the outer loop between failed passes.
RMU_STORE_ID=dynamodb-head
RMU_PROJECTION_NAME=group-chat-read-model
RMU_PROJECTION_VERSION=1
RMU_RETRY_MAX_ATTEMPTS=5
RMU_RETRY_INITIAL_DELAY_MS=200
RMU_RETRY_MAX_DELAY_MS=10000
RMU_RETRY_MAX_ELAPSED_MS=30000
RMU_RETRY_JITTER_RATIO=0.2
# recoverReadModel processes at most this many dead letters per run.
RMU_RECOVERY_BATCH_SIZE=100
# Maximum dead-letter rows written per aggregate in one stream batch. Events
# blocked behind the first failure are recorded up to this limit; the rest wait
# for redelivery. Minimum 1.
RMU_DEAD_LETTER_BATCH_LIMIT=100

# Dead-letter notification transport (SQS). The MySQL task is authoritative;
# the queue only triggers recovery sooner. Leave the URL empty to disable.
# Set the group id only for a FIFO queue; standard queues reject FIFO fields.
RMU_DEAD_LETTER_QUEUE_URL=
RMU_DEAD_LETTER_MESSAGE_GROUP_ID=
# Defaults to AWS_REGION. LocalStack uses AWS_DYNAMODB_ENDPOINT_URL as a fallback.
RMU_DEAD_LETTER_QUEUE_REGION=
AWS_SQS_ENDPOINT_URL=
# SQS recovery worker receive tuning (MaxNumberOfMessages is capped at 10 and
# WaitTimeSeconds at 20 by SQS).
RMU_DEAD_LETTER_CONSUME_MAX_MESSAGES=10
RMU_DEAD_LETTER_CONSUME_WAIT_TIME_SECONDS=20
RMU_DEAD_LETTER_CONSUME_VISIBILITY_TIMEOUT_SECONDS=60

# Local reader: a full head Scan runs at startup and after a 24h stall.
STREAM_POLL_INTERVAL_MS=200
STREAM_RETRY_INITIAL_DELAY_MS=1000
STREAM_RETRY_MAX_DELAY_MS=60000
STREAM_RETRY_JITTER_RATIO=0.2
STREAM_RETENTION_MS=86400000

# ESA v5 Spanner store: five tables named <prefix>_journal, <prefix>_head,
# <prefix>_snapshot_current, <prefix>_snapshot_history, <prefix>_config.
PERSISTENCE_SPANNER_TABLE_PREFIX=esa

# Lambda container reaches MySQL on the Compose network (see docker-compose-databases.yml).
DATABASE_URL_LAMBDA=mysql://ceer:ceer@mysql-local:3306/ceer

FUNCTION_NAME=read-model-updater-rmu
# Event source mapping: bisect a failing batch and keep successful records.
# The application dead-letters permanent failures in MySQL; the optional
# OnFailure destination on the mapping is only the provider-level safety net.
# Leave LAMBDA_MAX_RETRY_ATTEMPTS empty to keep Lambda's infinite retries.
LAMBDA_BATCH_SIZE=10
LAMBDA_DEAD_LETTER_ARN=
LAMBDA_MAX_RETRY_ATTEMPTS=
# LocalStack 2.x では nodejs20.x が無い場合があるため既定は nodejs18.x
LAMBDA_RUNTIME=nodejs18.x
COMPOSE_PROJECT=cqrs-es-example-js

# 1 = after deploy, stop container dynamodb-read-model-updater-1 to avoid double stream processing
STOP_LOCAL_RMU_AFTER_LAMBDA_DEPLOY=1

# docker-compose-up.sh: build/deploy Lambda zip when non-zero
DOCKER_COMPOSE_UP_BUILD_LAMBDA=1
DOCKER_COMPOSE_UP_DEPLOY_LAMBDA=1

# Override if your compose project name differs (affects LAMBDA_DOCKER_NETWORK default in compose).
# LAMBDA_DOCKER_NETWORK=cqrs-es-example-js_default
